{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "simulador",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "simulador/servidor.js"
      ],
      "port": 8123
    },
    {
      "name": "simulador-espera",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "simulador/servidor.js"
      ],
      "port": 8130,
      "env": {
        "ESPERA": "1",
        "PORT": "8130"
      }
    },
    {
      "name": "simulador-espera-cumplida",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "simulador/servidor.js"
      ],
      "port": 8131,
      "env": {
        "ESPERA": "0",
        "PORT": "8131"
      }
    }
  ]
}
